# Production environment configuration
VITE_NODE_ENV=production

# API配置 - 生产环境
VITE_API_BASE_URL=https://api.wanxiang-life.com/v1
VITE_SOCKET_URL=https://api.wanxiang-life.com

# 应用配置
VITE_APP_NAME=万象生活管理端
VITE_APP_VERSION=1.0.0

# 功能开关 - 生产环境配置
VITE_ENABLE_AI_SERVICE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=false

# 第三方服务 - 生产环境
VITE_UPLOAD_URL=https://api.wanxiang-life.com/upload
VITE_CDN_URL=https://cdn.wanxiang-life.com

# COS 配置
VITE_COS_BUCKET=universe-life-temp-1369282249
VITE_COS_REGION=ap-chengdu

# 生产安全设置
VITE_SHOW_DEVTOOLS=false
VITE_LOG_LEVEL=error