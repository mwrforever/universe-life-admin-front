# Development environment configuration
VITE_NODE_ENV=development

# API配置 - 开发环境（通过Vite代理访问网关）
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=ws://localhost:5001

# 应用配置
VITE_APP_NAME=万象生活管理端 (开发)
VITE_APP_VERSION=1.0.0-dev

# 功能开关 - 开发环境全部开启
VITE_ENABLE_AI_SERVICE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=true

# 第三方服务 - 开发环境暂不配置
# VITE_UPLOAD_URL=
# VITE_CDN_URL=

# 开发工具
VITE_SHOW_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# OAuth2 配置 - Spring Security Authorization Server (通过Vite代理)
VITE_OAUTH2_ISSUER=http://com.universe-life.back.front
VITE_OAUTH2_CLIENT_ID=aB3dE9fG1hI4jK5lM7nO0pQ2
VITE_OAUTH2_REDIRECT_URI=http://com.universe-life.back.front/auth/callback
VITE_OAUTH2_POST_LOGOUT_REDIRECT_URI=http://com.universe-life.auth.server/auth/login/employee
VITE_OAUTH2_SCOPE=openid profile