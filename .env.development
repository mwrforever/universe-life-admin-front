# Development environment configuration
VITE_NODE_ENV=development

# API配置 - 开发环境（通过Vite代理访问网关）
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=ws://localhost:5001

# 应用配置
VITE_APP_NAME=万象生活管理端 (开发)
VITE_APP_VERSION=1.0.0-dev

# 功能开关 - 开发环境全部开启
VITE_ENABLE_AI_SERVICE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=true

# 第三方服务 - 开发环境暂不配置
# VITE_UPLOAD_URL=
# VITE_CDN_URL=

# COS 配置
VITE_COS_BUCKET=universelifetemp-1369282249
VITE_COS_REGION=ap-chongqing

# 开发工具
VITE_SHOW_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# OAuth2配置 - Spring Authorization Server
VITE_OAUTH2_ISSUER=http://localhost:8099
VITE_OAUTH2_CLIENT_ID=Kp7vR9mNxq2L8tQwYzba
