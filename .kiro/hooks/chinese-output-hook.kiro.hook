{
  "enabled": true,
  "name": "中文输出规范",
  "description": "确保代码注释、解析说明以及所有相关输出内容均使用中文",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx",
      "*.js",
      "*.jsx",
      "*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "请检查刚刚编辑的文件，确保所有注释、文档说明和输出信息都使用中文。如果发现英文注释或说明，请将其翻译为中文。保持代码变量名和函数名使用英文，但注释和文档必须是中文。"
  }
}